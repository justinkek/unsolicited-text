#!/usr/bin/env bash

repository="$(cd "$(dirname "$0")/../.." && pwd)"
out="${1:-$repository/skills/reload/SKILL.md}"
steps="${2:?the reload steps to carry}"

home="$(mktemp -d)"
trap 'rm -rf "$home"' EXIT
mkdir -p "$home/state"
: > "$home/state/onboarded"

rules="$(printf '{"hook_event_name":"SessionStart"}' \
  | env -u UNSOLICITED_TEXT_PROSE_LINE_CEILING \
        -u UNSOLICITED_TEXT_PROSE_WORD_CEILING \
        -u UNSOLICITED_TEXT_QUEUE_EMOJI \
        -u UNSOLICITED_TEXT_BREADCRUMB \
        -u UNSOLICITED_TEXT_QUEUE_TREE \
        -u UNSOLICITED_TEXT_QUEUE_MAX_VISIBLE_ITEMS \
        UNSOLICITED_TEXT_HOME="$home" \
        "$repository/hooks/load-rules.sh")"

version="$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  "$repository/package.json" | head -1)"

cat "$repository/skills/reload/body.md" > "$out"

cat >> "$out" <<'HEAD'
# Reloading the rules

Rendered from unsolicited-text @@version@@. Say that version when asked which one
is installed, and say it is the version this file was built from rather than one
read off disk.

## The steps for this install

@@steps@@

## The rules, with every setting at its default

Where the steps above cannot be followed, follow these instead. They replace any
unsolicited-text rules printed earlier in this session.

HEAD

printf '%s\n' "$rules" >> "$out"

printf '\n## Note\n\nGenerated by ./build from rules/reply-shape.md, with every setting at its default.\n' >> "$out"

python3 - "$out" "$version" "$steps" <<'FILL'
import pathlib, sys
out, version, steps = pathlib.Path(sys.argv[1]), sys.argv[2], pathlib.Path(sys.argv[3])
out.write_text(out.read_text().replace("@@version@@", version).replace("@@steps@@", steps.read_text().strip()))
FILL
