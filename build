#!/usr/bin/env bash

set -e

repository="$(cd "$(dirname "$0")" && pwd)"
out="${1:-$repository/dist}"

published="https://github.com/justinkek/unsolicited-text/blob/main"
generated="Generated by ./build. Edit the sources at the repository root instead."

mark_scripts() {
  local folder="$1" script
  for script in "$folder"/*.sh "$folder"/hooks/*.sh; do
    [ -f "$script" ] || continue
    sed -i.bak "1a\\
# $generated" "$script"
    rm -f "$script.bak"
  done
}

section() {
  awk -v wanted="## $1" '
    $0 == wanted { inside = 1; next }
    /^#{1,2} [^#]/ { inside = 0 }
    inside { print }
  ' "$repository/INSTALL.md" \
    | sed -E "s@\]\(([A-Za-z-]+\.md)([^)]*)\)@](PUBLISHED/\1\2)@g" \
    | sed "s@PUBLISHED@$published@g" \
    | cat -s
}

ships() {
  local product="$1" part="$2"
  sed -n "s/^$product: //p" "$repository/products" | grep --quiet --word-regexp "$part"
}

payload() {
  local product="$1" target="$2" skill named
  mkdir -p "$target"
  cp "$repository/package.json" "$target/package.json"

  if ships "$product" hooks; then
    mkdir -p "$target/hooks"
    cp "$repository"/hooks/*.sh "$target/hooks/"
  fi

  if ships "$product" rules; then
    mkdir -p "$target/rules"
    cp "$repository/rules/reply-shape.md" "$target/rules/"
  fi

  if ships "$product" skills; then
    for skill in "$repository"/skills/*/SKILL.md; do
      named="$(basename "$(dirname "$skill")")"
      mkdir -p "$target/skills/$named"
      cp "$skill" "$target/skills/$named/SKILL.md"
    done
  fi

  if ships "$product" commands; then
    mkdir -p "$target/commands"
    cp "$repository"/commands/*.md "$target/commands/"
  fi
}

readme() {
  local target="$1" title="$2"
  {
    printf '# %s\n\n(audience: humans)\n\n' "$title"
    printf '%s\n\n' "$generated"
    printf 'Everything this install needs is in this folder.\n\n'
    printf '## Installing\n'
    shift 2
    printf '%s\n' "$@"
  } > "$target/README.md"
}

rm -rf "$out"

# Claude Code, ZCode, and the skills a chat client copies out of a plugin.
target="$out/claude-code"
payload claude-code "$target"
mkdir -p "$target/.claude-plugin"
jq --tab '{name, version, description, author}' "$repository/package.json" \
  > "$target/.claude-plugin/plugin.json"
cp "$repository/hooks/hooks.json" "$target/hooks/hooks.json"
readme "$target" "unsolicited-text for Claude Code and ZCode" "$(section 'Claude Code, ZCode')"

# Claude Code cloud sessions, where a container is rebuilt and no marketplace answers.
target="$out/claude-cloud"
payload claude-cloud "$target"
cp "$repository/harness-adapters/claude-code/cloud-settings.json" "$target/settings.json"
cp "$repository/harness-adapters/claude-code/install-cloud.sh" "$target/install.sh"
cp "$repository/harness-adapters/claude-code/refresh-cloud.sh" "$target/refresh.sh"
cp "$repository/harness-adapters/claude-code/merge-settings.sh" "$target/merge-settings.sh"
readme "$target" "unsolicited-text for Claude Code cloud sessions" "$(section 'Claude Code cloud sessions')"

# Codex, which registers the hooks by hand.
target="$out/codex"
payload codex "$target"
mkdir -p "$target/.codex-plugin"
jq --tab '{name, version, description, hooks: "./hooks/hooks.json",
  interface: { displayName, shortDescription: .description }}' "$repository/package.json" \
  > "$target/.codex-plugin/plugin.json"
cp "$repository/harness-adapters/codex/hooks.json" "$target/hooks/hooks.json"
readme "$target" "unsolicited-text for Codex" "$(section 'Codex')"

# Pi, which loads a shim that runs the same hooks.
target="$out/pi"
payload pi "$target"
mkdir -p "$target/src"
cp "$repository/harness-adapters/pi/src/index.ts" "$target/src/index.ts"
readme "$target" "unsolicited-text for Pi" "$(section 'Pi')"

# Claude Chat and Cowork, which copy the skills out of an installed plugin.
target="$out/chat-cowork"
mkdir -p "$target"
payload chat-cowork "$target"
rm -f "$target/package.json"
mark_scripts "$out/claude-code"
mark_scripts "$out/claude-cloud"
mark_scripts "$out/codex"
mark_scripts "$out/pi"

readme "$target" "unsolicited-text for Claude Chat and Cowork" "$(section 'Claude Chat, Cowork')" \
  "Nothing is installed from this folder. The client copies these skills out of the plugin, and they are all a session there receives."
