#!/usr/bin/env bash

set -e

directory="$(cd "$(dirname "$0")" && pwd)"
width="${LOGO_WIDTH:-880}"
font="${LOGO_FONT:-CommitMono}"

command -v rsvg-convert >/dev/null 2>&1 || { printf 'render: rsvg-convert is not installed (brew install librsvg)\n' >&2; exit 1; }

if command -v fc-list >/dev/null 2>&1 && ! fc-list --quiet ":family=$font"; then
  printf 'render: %s is not installed, the wordmark will fall back to another face\n' "$font" >&2
fi

rsvg-convert --width "$width" "$directory/logo.svg" --output "$directory/logo.png"

# The rendering is checked in, so the drawing it came from is written down beside
# it. A file time does not survive a clone; a hash of the content does.
printf '%s  logo.svg\n' "$(git -C "$directory" hash-object logo.svg)" > "$directory/rendered.sha"

printf 'render: wrote logo.png at %s wide\n' "$width"
