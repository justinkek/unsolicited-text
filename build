#!/usr/bin/env bash

set -e

repository="$(cd "$(dirname "$0")" && pwd)"
out="${1:-$repository/distributions}"
page="${2:-$repository/INSTALL.md}"

published="https://github.com/justinkek/unsolicited-text/blob/main"
generated="Generated by ./build. Edit the sources at the repository root instead."

mark_scripts() {
  local folder="$1" script
  for script in "$folder"/*.sh "$folder"/hooks/*.sh; do
    [ -f "$script" ] || continue
    sed -i.bak "1a\\
# $generated" "$script"
    rm -f "$script.bak"
  done
}

steps() {
  sed -E "s@\]\(([A-Za-z-]+\.md)([^)]*)\)@](PUBLISHED/\1\2)@g" "$repository/installs/$1.md" \
    | sed "s@PUBLISHED@$published@g"
}

distributions="$repository/distributions.json"

ships() {
  jq --exit-status --arg distribution "$1" --arg part "$2" \
    '.[$distribution].ships | index($part)' "$distributions" >/dev/null
}

stated() { jq --raw-output --arg distribution "$1" ".[\$distribution].$2" "$distributions"; }

folder_of() { jq --raw-output --arg distribution "$1" '.[$distribution]["same-as"] // $distribution' "$distributions"; }

payload() {
  local distribution="$1" target="$2" skill named
  mkdir -p "$target"
  cp "$repository/package.json" "$target/package.json"

  if ships "$distribution" hooks; then
    mkdir -p "$target/hooks"
    cp "$repository"/hooks/*.sh "$target/hooks/"
  fi

  if ships "$distribution" rules; then
    mkdir -p "$target/rules"
    cp "$repository/rules/reply-shape.md" "$target/rules/"
  fi

  if ships "$distribution" skills; then
    for skill in "$repository"/skills/*/SKILL.md; do
      named="$(basename "$(dirname "$skill")")"
      mkdir -p "$target/skills/$named"
      cp "$skill" "$target/skills/$named/SKILL.md"
    done
  fi

  if ships "$distribution" commands; then
    mkdir -p "$target/commands"
    cp "$repository"/commands/*.md "$target/commands/"
  fi
}

readme() {
  local distribution="$1" target="$2" page
  page="$({
    printf '# unsolicited-text for %s\n\n(audience: humans)\n\n' "$(stated "$distribution" title)"
    printf '## Installing\n\n'
    steps "$(jq --raw-output --arg distribution "$distribution" '.[$distribution]["same-as"] // $distribution' "$distributions")"
    shift 2
    if [ "$#" -gt 0 ]; then printf '\n%s\n' "$@"; fi
    printf '\n## Note\n\n%s\n' "$generated"
  })"
  printf '%s\n' "$page" > "$target/README.md"
}

# The install page a person reads on GitHub, from the same sources.
{
  cat "$repository/installs/intro.md"
  printf '\n%s\n' "Generated by ./build from installs/. Edit those files instead."
  printf '\nEvery install copies one folder under `distributions/`, which carries a README\n'
  printf 'with these same steps:\n\n'
  printf '| Client | Folder |\n| --- | --- |\n'
  for distribution in $(jq --raw-output 'keys_unsorted[]' "$distributions"); do
    printf '| %s | [distributions/%s](distributions/%s) |\n' "$(stated "$distribution" heading)" \
      "$(folder_of "$distribution")" "$(folder_of "$distribution")"
  done
  for distribution in $(jq --raw-output 'keys_unsorted[]' "$distributions"); do
    printf '\n## %s\n\n' "$(stated "$distribution" heading)"
    cat "$repository/installs/$distribution.md"
  done
  printf '\n'
  cat "$repository/installs/tail.md"
} > "$page"

rm -rf "$out"

# Claude Code. ZCode installs the same folder through its own settings.
target="$out/claude-code"
payload claude-code "$target"
mkdir -p "$target/.claude-plugin"
jq --tab '{name, version, description, author}' "$repository/package.json" \
  > "$target/.claude-plugin/plugin.json"
cp "$repository/hooks/hooks.json" "$target/hooks/hooks.json"
readme claude-code "$target"

# Claude Code cloud sessions, where a container is rebuilt and no marketplace answers.
target="$out/claude-cloud"
payload claude-cloud "$target"
cp "$repository/harness-adapters/claude-code/cloud-settings.json" "$target/settings.json"
cp "$repository/harness-adapters/claude-code/install-cloud.sh" "$target/install.sh"
cp "$repository/harness-adapters/claude-code/refresh-cloud.sh" "$target/refresh.sh"
cp "$repository/harness-adapters/claude-code/merge-settings.sh" "$target/merge-settings.sh"
readme claude-cloud "$target"

# Codex, which registers the hooks by hand.
target="$out/codex"
payload codex "$target"
mkdir -p "$target/.codex-plugin"
jq --tab '{name, version, description, hooks: "./hooks/hooks.json",
  interface: { displayName, shortDescription: .description }}' "$repository/package.json" \
  > "$target/.codex-plugin/plugin.json"
cp "$repository/harness-adapters/codex/hooks.json" "$target/hooks/hooks.json"
readme codex "$target"

# Pi, which loads a shim that runs the same hooks.
target="$out/pi"
payload pi "$target"
mkdir -p "$target/src"
cp "$repository/harness-adapters/pi/src/index.ts" "$target/src/index.ts"
readme pi "$target"

# Claude Chat and Cowork, which copy the skills out of an installed plugin.
target="$out/claude-chat-cowork"
mkdir -p "$target"
payload claude-chat-cowork "$target"
rm -f "$target/package.json"
for distribution in $(jq --raw-output 'to_entries[] | select(.value["same-as"] | not) | .key' "$distributions"); do
  mark_scripts "$out/$distribution"
done

readme claude-chat-cowork "$target" \
  "Nothing is installed from this folder. The client copies these skills out of the plugin, and they are all a session there receives."
