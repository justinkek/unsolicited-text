#!/usr/bin/env bash

set -e

repository="$(cd "$(dirname "$0")" && pwd)"
out="${1:-$repository/distributions}"
page="${2:-$repository/INSTALL.md}"

published="https://github.com/justinkek/unsolicited-text/blob/main"
generated="Generated by ./build. Edit the sources at the repository root instead."

mark_scripts() {
  local folder="$1" script
  for script in "$folder"/*.sh "$folder"/hooks/*.sh; do
    [ -f "$script" ] || continue
    sed -i.bak "1a\\
# $generated" "$script"
    rm -f "$script.bak"
  done
}

# One page of one client: clients/<client>/<page>.md, with its links published.
# A page holding {same as <client>} is that client's page, read in its place.
page() {
  local named="$1" source="$repository/clients/$2/$1.md" pointed
  pointed="$(sed -n "1s/^{same as \\([a-z-]*\\)}$/\\1/p" "$source")"
  if [ -n "$pointed" ]; then
    source="$repository/clients/$pointed/$named.md"
    if sed -n '1p' "$source" | grep --quiet '^{same as '; then
      printf 'clients/%s/%s.md points at %s, which points on again\n' "$2" "$named" "$pointed" >&2
      exit 1
    fi
  fi

  sed -E "s@\]\(([A-Za-z-]+\.md)([^)]*)\)@](PUBLISHED/\1\2)@g" "$source" \
    | sed "s@PUBLISHED@$published@g"
}

# A folder says what it is; distributions.json says how the folders relate.
named_client() { jq --raw-output '.name' "$repository/clients/$1/client.json"; }

# An install serving one client is called what that client is called.
named_distribution() {
  local named
  named="$(jq --raw-output --arg distribution "$1" '.[$distribution].name // empty' "$distributions")"
  if [ -z "$named" ]; then named="$(named_client "$(served "$1")")"; fi
  printf '%s' "$named"
}

distributions="$repository/distributions.json"

ships() {
  jq --exit-status --arg distribution "$1" --arg part "$2" \
    '.[$distribution].ships | index($part)' "$distributions" >/dev/null
}

folder_of() { jq --raw-output --arg distribution "$1" '.[$distribution]["same-as"] // $distribution' "$distributions"; }

distributes() { jq --raw-output 'keys_unsorted[]' "$distributions"; }

# Every distribution says which clients it serves, itself included.
served() {
  jq --exit-status --raw-output --arg distribution "$1" \
    '.[$distribution].serves[]' "$distributions"
}

# The steps for an install: one client's page, or one per client with the
# signature that tells them apart.
branched() {
  local named="$1" distribution="$2" client
  if [ "$(served "$distribution" | wc -l)" = "1" ]; then
    page "$named" "$(served "$distribution")"
    return 0
  fi

  printf 'One install serves several clients. Read the signatures, then follow the\n'
  printf 'steps under the one that matches.\n'
  for client in $(served "$distribution"); do
    printf '\n### %s\n\n' "$(named_client "$client")"
    cat "$repository/clients/$client/signature.md"
    printf '\n'
    page "$named" "$client"
  done
}

# A skill carries the steps for the clients its distribution serves, and no others.
carries() {
  local named="$1" steps="$2" distribution="$3" target="$4" out="$4/skills/$1/SKILL.md"
  mkdir -p "$target/skills/$named"
  cat "$repository/skills/$named/body.md" > "$out"
  printf '\n## The steps for this install\n\n' >> "$out"
  branched "$steps" "$distribution" >> "$out"
  printf '\n## Note\n\n%s\n' "$generated" >> "$out"
}

payload() {
  local distribution="$1" target="$2" reload_steps
  mkdir -p "$target"
  cp "$repository/package.json" "$target/package.json"

  if ships "$distribution" hooks; then
    mkdir -p "$target/hooks"
    cp "$repository"/hooks/*.sh "$target/hooks/"
  fi

  if ships "$distribution" rules; then
    mkdir -p "$target/rules"
    cp "$repository/rules/reply-shape.md" "$target/rules/"
  fi

  if ships "$distribution" skills; then
    mkdir -p "$target/skills/reload"
    reload_steps="$(mktemp)"
    branched reload "$distribution" > "$reload_steps"
    "$repository/skills/reload/render" "$target/skills/reload/SKILL.md" "$reload_steps"
    rm -f "$reload_steps"

    carries update update "$distribution" "$target"
    carries uninstall uninstall "$distribution" "$target"
    carries settings settings "$distribution" "$target"
  fi

  if ships "$distribution" commands; then
    mkdir -p "$target/commands"
    cp "$repository"/commands/*.md "$target/commands/"
  fi
}

# One section of a README: one client's page, or one per client under its name.
section() {
  local named="$1" heading="$2" distribution="$3" client shown="" first=1
  for client in $(served "$distribution"); do
    if [ -s "$repository/clients/$client/$named.md" ]; then shown="$shown $client"; fi
  done
  if [ -z "$shown" ]; then return 0; fi

  printf '## %s\n\n' "$heading"
  if [ "$(served "$distribution" | wc -l)" = "1" ]; then
    page "$named" "${shown# }"
  else
    for client in $shown; do
      if [ "$first" = "0" ]; then printf '\n'; fi
      first=0
      printf '### %s\n\n' "$(named_client "$client")"
      page "$named" "$client"
    done
  fi
  printf '\n'
}

readme() {
  local distribution="$1" target="$2" body
  body="$({
    printf '# unsolicited-text for %s\n\n(audience: humans)\n\n' "$(named_distribution "$distribution")"
    section support "What works" "$distribution"
    section install "Installing" "$distribution"
    section update "Updating" "$distribution"
    section uninstall "Uninstalling" "$distribution"
    printf '## Note\n\n%s\n' "$generated"
  })"
  printf '%s\n' "$body" > "$target/README.md"
}

# The install page a person reads on GitHub, from the same sources.
{
  cat "$repository/install-page/intro.md"
  printf '\nEvery install copies one folder under `distributions/`. Open the one for your\n'
  printf 'client and follow its README:\n\n'
  printf '| Client | Folder |\n| --- | --- |\n'
  for distribution in $(distributes); do
    printf '| %s | [distributions/%s](distributions/%s) |\n' "$(named_distribution "$distribution")" \
      "$(folder_of "$distribution")" "$(folder_of "$distribution")"
  done
  printf '\n'
  cat "$repository/install-page/tail.md"
  printf '\n## Note\n\n%s\n' "Generated by ./build from clients/. Edit those files instead."
} > "$page"

rm -rf "$out"

# One plugin, installed by every Claude client that reads the marketplace.
target="$out/claude"
payload claude "$target"
mkdir -p "$target/.claude-plugin"
jq --tab '{name, version, description, author}' "$repository/package.json" \
  > "$target/.claude-plugin/plugin.json"
cp "$repository/adapters/claude/hooks.json" "$target/hooks/hooks.json"
readme claude "$target"

# Claude Code cloud sessions, where a container is rebuilt and no marketplace answers.
target="$out/claude-code-cloud"
payload claude-code-cloud "$target"
cp "$repository/adapters/claude-code-cloud/settings.json" "$target/settings.json"
cp "$repository/adapters/claude-code-cloud/install.sh" "$target/install.sh"
cp "$repository/adapters/claude-code-cloud/refresh.sh" "$target/refresh.sh"
cp "$repository/adapters/claude-code-cloud/merge-settings.sh" "$target/merge-settings.sh"
readme claude-code-cloud "$target"

# Codex, which registers the hooks by hand.
target="$out/codex"
payload codex "$target"
mkdir -p "$target/.codex-plugin"
jq --tab '{name, version, description, hooks: "./hooks/hooks.json",
  interface: { displayName, shortDescription: .description }}' "$repository/package.json" \
  > "$target/.codex-plugin/plugin.json"
cp "$repository/adapters/codex/hooks.json" "$target/hooks/hooks.json"
readme codex "$target"

# Pi, which loads an adapter that runs the same hooks.
target="$out/pi"
payload pi "$target"
mkdir -p "$target/src"
cp "$repository/adapters/pi/src/index.ts" "$target/src/index.ts"
readme pi "$target"

for distribution in $(distributes); do
  mark_scripts "$out/$distribution"
done

