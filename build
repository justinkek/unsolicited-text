#!/usr/bin/env bash

set -e

repository="$(cd "$(dirname "$0")" && pwd)"
out="${1:-$repository/distributions}"
page="${2:-$repository/INSTALL.md}"

published="https://github.com/justinkek/unsolicited-text/blob/main"
generated="Generated by ./build. Edit the sources at the repository root instead."

mark_scripts() {
  local folder="$1" script
  for script in "$folder"/*.sh "$folder"/hooks/*.sh; do
    [ -f "$script" ] || continue
    sed -i.bak "1a\\
# $generated" "$script"
    rm -f "$script.bak"
  done
}

# One page of one client: clients/<client>/<page>.md, with its links published.
page() {
  sed -E "s@\]\(([A-Za-z-]+\.md)([^)]*)\)@](PUBLISHED/\1\2)@g" "$repository/clients/$2/$1.md" \
    | sed "s@PUBLISHED@$published@g"
}

clients="$repository/clients.json"

ships() {
  jq --exit-status --arg distribution "$1" --arg part "$2" \
    '.[$distribution].ships | index($part)' "$clients" >/dev/null
}

stated() { jq --raw-output --arg distribution "$1" ".[\$distribution].$2" "$clients"; }

folder_of() { jq --raw-output --arg distribution "$1" '.[$distribution]["same-as"] // $distribution' "$clients"; }

# Every distribution builds a folder; the rest are clients one of them serves.
distributes() { jq --raw-output 'to_entries[] | select(.value.ships) | .key' "$clients"; }

served() {
  jq --raw-output --arg distribution "$1" \
    '(.[$distribution].serves // [$distribution])[]' "$clients"
}

# A skill carries the steps for the clients its distribution serves, and no others.
carries() {
  local named="$1" page="$2" distribution="$3" target="$4" out="$4/skills/$1/SKILL.md" client
  mkdir -p "$target/skills/$named"
  cat "$repository/skills/$named/body.md" > "$out"

  if [ "$(served "$distribution" | wc -l)" = "1" ]; then
    printf '\n## The steps for this install\n\n' >> "$out"
    page "$page" "$distribution" >> "$out"
  else
    printf '\n## The steps for this install\n\n' >> "$out"
    printf 'One install serves several clients. Read the signatures, then follow the\n' >> "$out"
    printf 'steps under the one that matches.\n' >> "$out"
    for client in $(served "$distribution"); do
      printf '\n### %s\n\n' "$(jq --raw-output --arg client "$client" '.[$client].name' "$clients")" >> "$out"
      cat "$repository/clients/$client/signature.md" >> "$out"
      printf '\n' >> "$out"
      page "$page" "$client" >> "$out"
    done
  fi

  printf '\n## Note\n\n%s\n' "$generated" >> "$out"
}

payload() {
  local distribution="$1" target="$2" skill named
  mkdir -p "$target"
  cp "$repository/package.json" "$target/package.json"

  if ships "$distribution" hooks; then
    mkdir -p "$target/hooks"
    cp "$repository"/hooks/*.sh "$target/hooks/"
  fi

  if ships "$distribution" rules; then
    mkdir -p "$target/rules"
    cp "$repository/rules/reply-shape.md" "$target/rules/"
  fi

  if ships "$distribution" skills; then
    mkdir -p "$target/skills/reload"
    "$repository/skills/reload/render" "$target/skills/reload/SKILL.md" \
      "$repository/clients/$distribution/reload.md"

    carries update update "$distribution" "$target"
    carries uninstall uninstall "$distribution" "$target"
    carries settings settings "$distribution" "$target"
  fi

  if ships "$distribution" commands; then
    mkdir -p "$target/commands"
    cp "$repository"/commands/*.md "$target/commands/"
  fi
}

readme() {
  local distribution="$1" target="$2" page
  page="$({
    printf '# unsolicited-text for %s\n\n(audience: humans)\n\n' "$(stated "$distribution" name)"
    # A distribution that is not supported everywhere says here what is missing.
    if [ -s "$repository/clients/$distribution/support.md" ]; then
      printf '## What works\n\n'
      page support "$distribution"
      printf '\n'
    fi
    printf '## Installing\n\n'
    page install "$distribution"
    printf '\n## Updating\n\n'
    page update "$distribution"
    printf '\n## Uninstalling\n\n'
    page uninstall "$distribution"
    printf '\n## Note\n\n%s\n' "$generated"
  })"
  printf '%s\n' "$page" > "$target/README.md"
}

# The install page a person reads on GitHub, from the same sources.
{
  cat "$repository/install-page/intro.md"
  printf '\nEvery install copies one folder under `distributions/`. Open the one for your\n'
  printf 'client and follow its README:\n\n'
  printf '| Client | Folder |\n| --- | --- |\n'
  for distribution in $(distributes); do
    printf '| %s | [distributions/%s](distributions/%s) |\n' "$(stated "$distribution" name)" \
      "$(folder_of "$distribution")" "$(folder_of "$distribution")"
  done
  printf '\n'
  cat "$repository/install-page/tail.md"
  printf '\n## Note\n\n%s\n' "Generated by ./build from clients/. Edit those files instead."
} > "$page"

rm -rf "$out"

# One plugin, installed by every Claude client that reads the marketplace.
target="$out/claude"
payload claude "$target"
mkdir -p "$target/.claude-plugin"
jq --tab '{name, version, description, author}' "$repository/package.json" \
  > "$target/.claude-plugin/plugin.json"
cp "$repository/clients/claude/adapter/hooks.json" "$target/hooks/hooks.json"
readme claude "$target"

# Claude Code cloud sessions, where a container is rebuilt and no marketplace answers.
target="$out/claude-code-cloud"
payload claude-code-cloud "$target"
cp "$repository/clients/claude-code-cloud/adapter/settings.json" "$target/settings.json"
cp "$repository/clients/claude-code-cloud/adapter/install.sh" "$target/install.sh"
cp "$repository/clients/claude-code-cloud/adapter/refresh.sh" "$target/refresh.sh"
cp "$repository/clients/claude-code-cloud/adapter/merge-settings.sh" "$target/merge-settings.sh"
readme claude-code-cloud "$target"

# Codex, which registers the hooks by hand.
target="$out/codex"
payload codex "$target"
mkdir -p "$target/.codex-plugin"
jq --tab '{name, version, description, hooks: "./hooks/hooks.json",
  interface: { displayName, shortDescription: .description }}' "$repository/package.json" \
  > "$target/.codex-plugin/plugin.json"
cp "$repository/clients/codex/adapter/hooks.json" "$target/hooks/hooks.json"
readme codex "$target"

# Pi, which loads an adapter that runs the same hooks.
target="$out/pi"
payload pi "$target"
mkdir -p "$target/src"
cp "$repository/clients/pi/adapter/src/index.ts" "$target/src/index.ts"
readme pi "$target"

for distribution in $(distributes); do
  mark_scripts "$out/$distribution"
done

