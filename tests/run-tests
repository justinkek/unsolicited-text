#!/usr/bin/env bash

tests_directory="$(cd "$(dirname "$0")" && pwd)"

# One build for the whole suite. Each test runs the hooks an install copies,
# not the sources, and building them thirty times over is thirty times the wait.
built="$(mktemp -d)"
trap 'rm -rf "$built"' EXIT
if ! "$tests_directory/../build" "$built/distributions" "$built/INSTALL.md" >/dev/null; then
  printf 'the build failed, so there is nothing to test\n' >&2
  exit 1
fi
export UNSOLICITED_TEXT_BUILT="$built/distributions"
pass=0
fail=0
failures=""

for test in "$tests_directory"/test-*.sh; do
  name="$(basename "$test")"
  if output="$(bash "$test" 2>&1)"; then
    printf "PASS  %s\n" "$name"
    pass=$((pass + 1))
  else
    printf "FAIL  %s\n" "$name"
    fail=$((fail + 1))
    failures="$failures--- $name"$'\n'"$output"$'\n\n'
  fi
done

printf "\n%d passed, %d failed\n" "$pass" "$fail"
[ "$fail" -eq 0 ] && exit 0

printf "\n%s" "$failures"
exit 1
