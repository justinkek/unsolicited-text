#!/usr/bin/env bash

set -e

directory="$(cd "$(dirname "$0")" && pwd)"
height="${DEMO_HEIGHT:-500}"
runtime="${DEMO_RUNTIME:-12}"

command -v vhs >/dev/null 2>&1 || { printf 'record: vhs is not installed (brew install vhs)\n' >&2; exit 1; }

record_one() {
  local name="$1" tape typed=0 lines=0 line
  tape="$(mktemp)"
  {
    printf 'Output %s.gif\n\n' "$name"
    printf 'Set Shell bash\n'
    printf 'Set FontSize 13\n'
    printf 'Set Width 400\n'
    printf 'Set Height %s\n' "$height"
    printf 'Set Padding 12\n'
    printf 'Set Framerate 15\n'
    printf 'Set TypingSpeed 8ms\n\n'
    printf 'Hide\n'
    printf 'Type "clear; cat > /dev/null"\nEnter\n'
    printf 'Show\n\n'
    while IFS= read -r line; do
      if [ -z "$line" ]; then
        printf 'Enter\n'
      else
        printf 'Type "%s"\nEnter\n' "$line"
        typed=$((typed + ${#line}))
      fi
      lines=$((lines + 1))
    done < "$directory/$name.txt"
    printf 'Sleep %ss\n' "$(awk -v runtime="$runtime" -v typed="$typed" -v lines="$lines" \
      'BEGIN { printf "%.1f", runtime - typed * 0.008 - lines * 0.07 }')"
  } > "$tape"
  ( cd "$directory" && vhs "$tape" >/dev/null )
  rm -f "$tape"
  printf 'record: wrote %s.gif\n' "$name"
}

for name in before after; do
  record_one "$name"
done
