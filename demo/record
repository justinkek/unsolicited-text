#!/usr/bin/env bash

set -e

directory="$(cd "$(dirname "$0")" && pwd)"
height="${DEMO_HEIGHT:-500}"
columns="${DEMO_COLUMNS:-44}"
pixels="${DEMO_PIXELS:-400}"
font="${DEMO_FONT:-CommitMono}"
rate="${DEMO_RATE:-85}"
runtime="${DEMO_RUNTIME:-10}"

command -v vhs >/dev/null 2>&1 || { printf 'record: vhs is not installed (brew install vhs)\n' >&2; exit 1; }

if command -v fc-list >/dev/null 2>&1 && ! fc-list --quiet ":family=$font"; then
  printf 'record: %s is not installed, the recording will fall back to another face\n' "$font" >&2
fi

width_of() {
  local wanted="$directory/$1.width"
  [ -f "$wanted" ] && head -1 "$wanted" || printf '%s' "$pixels"
}

columns_of() {
  awk -v pixels="$(width_of "$1")" -v fits="$columns" -v standard="$pixels" \
    'BEGIN { printf "%d", pixels * fits / standard }'
}

record_one() {
  local name="$1" prompt="$2" pair="$3" tape
  tape="$(mktemp)"
  {
    printf 'Output %s.gif\n\n' "$name"
    printf 'Set Shell bash\n'
    printf 'Set Theme { "background": "#eff0f2", "foreground": "#485160", "cursor": "#eff0f2", "selection": "#dfe1e5", "black": "#485160", "red": "#e08a72", "green": "#66c2b4", "yellow": "#b58900", "blue": "#56789c", "magenta": "#d33682", "cyan": "#5a8f9b", "white": "#b0b0b0", "brightBlack": "#767676", "brightRed": "#ee9d85", "brightGreen": "#9cd2cd", "brightYellow": "#fba054", "brightBlue": "#7fa3c7", "brightMagenta": "#e0589f", "brightCyan": "#6fa3b0", "brightWhite": "#485160" }\n'
    printf 'Set FontFamily "%s"\n' "$font"
    printf 'Set FontSize 13\n'
    printf 'Set Width %s\n' "$(width_of "$pair")"
    printf 'Set Height %s\n' "$height"
    printf 'Set Padding 12\n'
    printf 'Set Framerate 15\n\n'
    printf 'Hide\n'
    printf 'Type "clear; ./type %s %s.txt %s %s; sleep 60"\nEnter\n' "$prompt" "$name" "$(columns_of "$pair")" "$rate"
    printf 'Sleep 400ms\n'
    printf 'Show\n\n'
    printf 'Sleep %ss\n' "$runtime"
  } > "$tape"
  ( cd "$directory" && vhs "$tape" >/dev/null )
  rm -f "$tape"
  printf 'record: wrote %s.gif\n' "$name"
}

# The recordings are checked in, so what they were recorded from is written down
# beside them. A file time does not survive a clone; a hash of the content does.
write_sources() {
  local pair="$1" source
  : > "$directory/$pair.sha"
  for source in type "$pair.prompt" "$pair-before.txt" "$pair-after.txt"; do
    printf '%s  %s\n' "$(git -C "$directory" hash-object "$source")" "$source" \
      >> "$directory/$pair.sha"
  done
}

wanted="$*"

for prompt in "$directory"/*.prompt; do
  pair="$(basename "$prompt" .prompt)"
  case " $wanted " in
    "  ") ;;
    *" $pair "*) ;;
    *) continue ;;
  esac
  for side in before after; do
    record_one "$pair-$side" "$(basename "$prompt")" "$pair"
  done
  write_sources "$pair"
done
