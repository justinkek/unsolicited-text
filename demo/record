#!/usr/bin/env bash

set -e

directory="$(cd "$(dirname "$0")" && pwd)"
height="${DEMO_HEIGHT:-500}"
columns="${DEMO_COLUMNS:-44}"
rate="${DEMO_RATE:-85}"
runtime="${DEMO_RUNTIME:-12}"

command -v vhs >/dev/null 2>&1 || { printf 'record: vhs is not installed (brew install vhs)\n' >&2; exit 1; }

record_one() {
  local name="$1" tape
  tape="$(mktemp)"
  {
    printf 'Output %s.gif\n\n' "$name"
    printf 'Set Shell bash\n'
    printf 'Set Theme { "background": "#eff0f2", "foreground": "#485160", "cursor": "#eff0f2", "selection": "#dfe1e5", "black": "#485160", "red": "#e08a72", "green": "#66c2b4", "yellow": "#b58900", "blue": "#56789c", "magenta": "#d33682", "cyan": "#5a8f9b", "white": "#b0b0b0", "brightBlack": "#767676", "brightRed": "#ee9d85", "brightGreen": "#9cd2cd", "brightYellow": "#fba054", "brightBlue": "#7fa3c7", "brightMagenta": "#e0589f", "brightCyan": "#6fa3b0", "brightWhite": "#485160" }\n'
    printf 'Set FontSize 13\n'
    printf 'Set Width 400\n'
    printf 'Set Height %s\n' "$height"
    printf 'Set Padding 12\n'
    printf 'Set Framerate 15\n\n'
    printf 'Hide\n'
    printf 'Type "clear; ./type prompt.txt %s.txt %s %s; sleep 60"\nEnter\n' "$name" "$columns" "$rate"
    printf 'Sleep 400ms\n'
    printf 'Show\n\n'
    printf 'Sleep %ss\n' "$runtime"
  } > "$tape"
  ( cd "$directory" && vhs "$tape" >/dev/null )
  rm -f "$tape"
  printf 'record: wrote %s.gif\n' "$name"
}

for name in before after; do
  record_one "$name"
done
